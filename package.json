{
  "name": "mistake-watch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:check": "node scripts/dev-check.mjs",
    "dev:next": "next dev --hostname 127.0.0.1 --port 5371",
    "dev:any": "next dev",
    "spacetime:start": "spacetime start --listen-addr 127.0.0.1:5372 --non-interactive",
    "spacetime:publish": "spacetime publish --server http://127.0.0.1:5372",
    "spacetime:generate": "spacetime generate",
    "spacetime:server-token": "node scripts/create-spacetime-server-token.mjs",
    "build": "next build",
    "benchmark:queue": "node scripts/benchmark-queue-derived-state.mjs",
    "benchmark:media-hub": "node scripts/benchmark-media-hub-catalogue.mjs",
    "benchmark:recommendations": "node scripts/benchmark-recommendation-baseline.mjs",
    "start": "next start",
    "test": "node --experimental-strip-types --test",
    "test:identity": "node --test tests/identity/*.test.mjs",
    "test:dev": "node --test tests/dev/*.test.mjs",
    "test:queue": "node --test tests/queue/*.test.mjs",
    "test:spacetime": "node --test tests/spacetime/*.test.mjs",
    "test:recommendation-runtime": "node scripts/verify-recommendation-reducers.mjs",
    "test:room-rhythm-runtime": "node scripts/verify-room-rhythm-reducers.mjs",
    "test:sync": "node --test tests/player/*.test.mjs",
    "test:youtube": "node --test tests/youtube/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --check \"app/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,mjs,ts}\"",
    "format:batch2": "prettier --check components/room/queue-panel.tsx components/room/queue components/room/shared components/room/listen/add-media lib/media/assets.ts lib/media/contracts.ts lib/media/shared.ts lib/media/folders lib/media/library lib/media/processing lib/media/source-matches lib/media/uploads scripts/check-file-lengths.mjs tests/dev/file-length-policy.test.mjs tests/media/source-match-access.test.mjs tests/media/uploaded-catalogue-policy.test.mjs tests/media/uploaded-playback-reference.test.mjs tests/queue/add-media-ui.test.mjs tests/queue/derived.test.mjs",
    "check:file-lengths": "node scripts/check-file-lengths.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/speed-insights": "^2.0.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "spacetimedb": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
