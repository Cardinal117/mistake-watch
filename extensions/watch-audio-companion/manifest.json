{
  "manifest_version": 3,
  "name": "Mistake Watch Audio Companion",
  "description": "Private local audio timing companion for trusted Mistake Watch users.",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": ["activeTab", "offscreen", "tabCapture"],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Enable Mistake Watch audio capture"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'; connect-src 'none'"
  }
}
