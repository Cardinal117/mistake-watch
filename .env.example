# Supabase project: watch-mistakestudios
NEXT_PUBLIC_SUPABASE_URL=https://qzmivwhzotuleivzphhm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# SpacetimeDB live room engine.
# Local development:
# NEXT_PUBLIC_SPACETIME_URI=ws://127.0.0.1:5372
# Production:
# NEXT_PUBLIC_SPACETIME_URI=https://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIME_URI=ws://127.0.0.1:5372
NEXT_PUBLIC_SPACETIME_MODULE=mistake-watch-rooms

# Server-only keys must never be exposed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me_server_only
SPACETIME_SERVER_AUTH_TOKEN=replace_me_server_only

# Server-only YouTube Data API key for provider metadata. Do not prefix with
# NEXT_PUBLIC_; the browser calls /api/youtube/metadata instead.
YOUTUBE_API_KEY=replace_me_server_only
