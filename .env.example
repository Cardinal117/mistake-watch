NEXT_PUBLIC_APP_URL=http://127.0.0.1:5371

# Server-only exact account IDs; empty disables compact playback exceptions.
COMPACT_PLAYBACK_ACCOUNT_IDS=

# Supabase project: watch-mistakestudios
NEXT_PUBLIC_SUPABASE_URL=https://qzmivwhzotuleivzphhm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# SpacetimeDB live room engine.
# Local development:
# NEXT_PUBLIC_SPACETIME_URI=ws://127.0.0.1:5372
# Production:
# NEXT_PUBLIC_SPACETIME_URI=https://maincloud.spacetimedb.com
NEXT_PUBLIC_SPACETIME_URI=ws://127.0.0.1:5372
NEXT_PUBLIC_SPACETIME_MODULE=mistake-watch-rooms

# Server-only keys must never be exposed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me_server_only
SPACETIME_SERVER_AUTH_TOKEN=replace_me_server_only

# Server-only YouTube Data API key for provider metadata. Do not prefix with
# NEXT_PUBLIC_; the browser calls /api/youtube/metadata instead.
YOUTUBE_API_KEY=replace_me_server_only

# Private uploaded-media Range gateway. Vercel externally rewrites the
# same-origin browser path to this server-only Worker origin. Both secrets must
# be independently generated server-only values.
MEDIA_GATEWAY_UPSTREAM_ORIGIN=https://replace-with-worker-subdomain.workers.dev
MEDIA_GATEWAY_SIGNING_SECRET=replace_with_at_least_32_random_characters
MEDIA_GATEWAY_ORIGIN_SECRET=replace_with_a_different_32_character_secret

# TASK-028 Personal entry gate. Database private.room_kind_features must also be enabled.
PERSONAL_ROOMS_ENABLED=false

# Shared creation is opt-in after membership and live revocation QA.
SHARED_ROOMS_ENABLED=false

# TASK-028.5: enable only after reviewed durable migration; false by default.
THEMED_ROOMS_ENABLED=false

# TASK-028.6: independent database gate also defaults off.
TEMPORARY_ROOMS_ENABLED=false
